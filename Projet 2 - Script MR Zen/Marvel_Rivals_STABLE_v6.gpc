/* ==============================================================================
   MAGNETO
   ============================================================================== */
combo magneto_bnb {
    // Premier R2
    set_val(PS4_R2, 100);
    wait(35);
    set_val(PS4_R2, 0);

    // Petit délai avant L1
    wait(180);

    // L1
    set_val(PS4_L1, 100);
    wait(100);
    set_val(PS4_L1, 0);

    // Délai avant le second R2
    wait(700);

    // Deuxième R2
    set_val(PS4_R2, 100);
    wait(35);
    set_val(PS4_R2, 0);
}

