/* ==============================================================================
   AIM ASSIST REINFORCEMENT PROFILES
   ============================================================================== */


/* HITSCAN - regular vertical ellipse
   Example heroes: Hela, Psylocke, Elsa
*/
combo aa_hitscan_profile {

    set_val(PS4_RX, 4);
    set_val(PS4_RY, 0);
    wait(15);

    set_val(PS4_RX, 3);
    set_val(PS4_RY, 6);
    wait(15);

    set_val(PS4_RX, 0);
    set_val(PS4_RY, 8);
    wait(15);

    set_val(PS4_RX, -3);
    set_val(PS4_RY, 6);
    wait(15);

    set_val(PS4_RX, -4);
    set_val(PS4_RY, 0);
    wait(15);

    set_val(PS4_RX, -3);
    set_val(PS4_RY, -6);
    wait(15);

    set_val(PS4_RX, 0);
    set_val(PS4_RY, -8);
    wait(15);

    set_val(PS4_RX, 3);
    set_val(PS4_RY, -6);
    wait(15);
}


/* PROJECTILE - softer/slower ellipse
   Example heroes: Namor, Magneto, Dr Strange, Winter Soldier
*/
combo aa_projectile_profile {

    set_val(PS4_RX, 4);
    set_val(PS4_RY, 0);
    wait(17);

    set_val(PS4_RX, 3);
    set_val(PS4_RY, 4);
    wait(17);

    set_val(PS4_RX, 0);
    set_val(PS4_RY, 6);
    wait(17);

    set_val(PS4_RX, -3);
    set_val(PS4_RY, 4);
    wait(17);

    set_val(PS4_RX, -4);
    set_val(PS4_RY, 0);
    wait(17);

    set_val(PS4_RX, -3);
    set_val(PS4_RY, -4);
    wait(17);

    set_val(PS4_RX, 0);
    set_val(PS4_RY, -6);
    wait(17);

    set_val(PS4_RX, 3);
    set_val(PS4_RY, -4);
    wait(17);
}


/* MELEE - irregular/asymmetrical pattern
   Example heroes: Spider-Man, Black Cat, Magik
*/
combo aa_melee_profile {

    set_val(PS4_RX, 5);
    set_val(PS4_RY, 0);
    wait(12);

    set_val(PS4_RX, -4);
    set_val(PS4_RY, 7);
    wait(13);

    set_val(PS4_RX, 5);
    set_val(PS4_RY, 1);
    wait(11);

    set_val(PS4_RX, 4);
    set_val(PS4_RY, -2);
    wait(12);

    set_val(PS4_RX, 0);
    set_val(PS4_RY, 9);
    wait(13);

    set_val(PS4_RX, 2);
    set_val(PS4_RY, -7);
    wait(11);

    set_val(PS4_RX, -5);
    set_val(PS4_RY, -3);
    wait(12);

    set_val(PS4_RX, 3);
    set_val(PS4_RY, 5);
    wait(13);
}


/* ==============================================================================
   NOTIFICATIONS
   ============================================================================== */

combo notify_change {

    set_rumble(RUMBLE_A, 50);
    wait(150);

    reset_rumble();
}


combo notify_toggle {

    set_rumble(RUMBLE_B, 30);
    wait(100);

    reset_rumble();
}


combo notify_profile_lock {

    set_rumble(RUMBLE_A, 70);
    set_rumble(RUMBLE_B, 70);
    wait(100);

    reset_rumble();
    wait(80);

    set_rumble(RUMBLE_A, 70);
    set_rumble(RUMBLE_B, 70);
    wait(100);

    reset_rumble();
}


/* ==============================================================================
   CHARACTER PROFILE
   ============================================================================== */

function call_active_char_profile() {

    if (
        selected_char == CHAR_SPIDERMAN
        ||
        selected_char == CHAR_BLACKCAT
        ||
        selected_char == CHAR_MAGIK
    ) {

        char_type = TYPE_MELEE;

        char_deadzone = 6;
        char_threshold = char_deadzone + 3;
    }


    else if (
        selected_char == CHAR_NAMOR
        ||
        selected_char == CHAR_MAGNETO
        ||
        selected_char == CHAR_DRSTRANGE
        ||
        selected_char == CHAR_WINTERSOLDIER
    ) {

        char_type = TYPE_PROJECTILE;

        char_deadzone = 8;
        char_threshold = char_deadzone + 4;
    }


    else if (
        selected_char == CHAR_HELA
        ||
        selected_char == CHAR_PSYLOCKE
        ||
        selected_char == CHAR_ELSA
    ) {

        char_type = TYPE_HITSCAN;

        char_deadzone = 4;
        char_threshold = char_deadzone + 5;
    }

    update_display = TRUE;
}


/* ==============================================================================
   OLED DISPLAY
   ============================================================================== */
function draw_display() {

    cls_oled(OLED_BLACK);


    if (selected_char == CHAR_SPIDERMAN) {

        print(
            2,
            2,
            OLED_FONT_SMALL,
            OLED_WHITE,
            TXT_SPIDERMAN[0]
        );
    }

    else if (selected_char == CHAR_BLACKCAT) {

        print(
            2,
            2,
            OLED_FONT_SMALL,
            OLED_WHITE,
            TXT_BLACKCAT[0]
        );
    }

    else if (selected_char == CHAR_MAGIK) {

        print(
